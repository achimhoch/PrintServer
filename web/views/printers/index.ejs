<!DOCTYPE html>

<html>

    <head>

        <meta charset="utf8">

        <title>PrintServer</title>

        <link rel="stylesheet" href="/css/bootstrap.min.css">

    </head>

    <body>

        <div class="container mt-4">

            <h2>Drucker</h2>
            <table class="table table-striped" id="printerTable">  

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>IP</th>
                        <th>Ort</th>
                        <th>Status</th>
                        <th>Online</th>
                        <th>Farbe</th>
                        <th>Duplex</th>
                        <th>Action</th>

                    </tr>
                </thead>
                <tbody>
                    <% 
                        for( let i in printers) { 
                    %>
                    <tr>
                        <td><%= printers[i].name %></td>
                        <td><%= printers[i].ip %></td>
                        <td><%= printers[i].location %></td>
                        <td><%= printers[i].status %></td>
                        <td><span class="badge <%= printers[i].online ? "bg-success" : "bg-danger" %>"><%= printers[i].online ? "Online" : "Offline" %></span></td> 
                        <td><span class="badge <%= printers[i].color ? "bg-primary" : "bg-secondary" %>"><%= printers[i].color ? "Ja" : "Nein" %></span></td>
                        <td><span class="badge <%= printers[i].duplex ? "bg-primary" : "bg-secondary" %>"><%= printers[i].duplex ? "Ja" : "Nein" %></span></td>
                        <td><a href="/printers/<%=printers[i].id %>">View</a></td>
                    </tr>
                    <% } %>
                </tbody> 
            </table> 
        </div>
        <div class="row mt-3">
            <div class="col-auto"> 
                <select id="pageSize" class="form-select">
                    <option value="10">10</option>
                    <option value="25" selected="25">25</option> 
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
            </div>
            <div class="col">
                <ul class="pagination" id="pagination">
                    
                </ul>
            </div>
            <div class="col-auto">
                <span id="printerCount"></span>
            </div>
            
        </div>
        

    </body>

</html>