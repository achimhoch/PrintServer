<%- include('../header.ejs') %>
<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Drucker Discovery
            </h1>

            <p class="text-muted mb-0">
                Netzwerk nach Druckern durchsuchen
            </p>
        </div>

        <div>

            <button
                id="btnDiscoveryScan"
                type="button"
                class="btn btn-primary">

                <span
                    id="discoveryScanSpinner"
                    class="spinner-border spinner-border-sm d-none"
                    role="status"
                    aria-hidden="true">
                </span>

                <span id="discoveryScanText">
                    Jetzt scannen
                </span>

            </button>

        </div>

    </div>


    <!-- Status -->

    <div
        id="discoveryAlert"
        class="alert d-none"
        role="alert">
    </div>


    <div class="row g-3 mb-4">

        <div class="col-md-3">

            <div class="card">

                <div class="card-body">

                    <div class="text-muted small">
                        Status
                    </div>

                    <div
                        id="discoveryRunning"
                        class="fs-5">
                        -
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card">

                <div class="card-body">

                    <div class="text-muted small">
                        Scan
                    </div>

                    <div
                        id="discoveryScanning"
                        class="fs-5">
                        -
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card">

                <div class="card-body">

                    <div class="text-muted small">
                        Letzter Scan
                    </div>

                    <div
                        id="discoveryLastScan"
                        class="fs-6">
                        -
                    </div>

                </div>

            </div>

        </div>


        <div class="col-md-3">

            <div class="card">

                <div class="card-body">

                    <div class="text-muted small">
                        Nächster Scan
                    </div>

                    <div
                        id="discoveryNextScan"
                        class="fs-6">
                        -
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Provider -->

    <div class="card">

        <div class="card-header">

            <strong>
                Discovery Provider
            </strong>

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table
                    class="table table-hover mb-0">

                    <thead>

                        <tr>

                            <th>
                                Provider
                            </th>

                            <th>
                                Typ
                            </th>

                            <th>
                                Aktiv
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Scans
                            </th>

                            <th>
                                Gefunden
                            </th>

                            <th>
                                Fehler
                            </th>

                        </tr>

                    </thead>

                    <tbody
                        id="discoveryProviders">

                        <tr>

                            <td
                                colspan="7"
                                class="text-center text-muted">

                                Lade Provider ...

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
 <%- include('../footer.ejs') %>

<script src="js/discovery/discovery.js"></script>
